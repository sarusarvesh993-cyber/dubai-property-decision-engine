{
  "description": "Evaluation set for the Ask the data copilot. Each case states what the parser must extract and, where the answer is data-independent, what the answer must contain. Run with: npm run eval:ask",
  "pass_threshold": 0.8,
  "cases": [
    { "q": "Is AED 1.5m fair for a 750 sqft 1 bed in Business Bay?", "expect": { "areas": ["Business Bay"], "subType": "Flat", "rooms": "1 B/R", "sizeSqft": 750, "price": 1500000, "intents": ["price"], "facts": ["fair_price"], "answer": ["AED/sqft", "percentile"] } },
    { "q": "Is 2,000,000 a good price for an 1100 sqft apartment in Dubai Marina", "expect": { "areas": ["Dubai Marina"], "subType": "Flat", "sizeSqft": 1100, "price": 2000000, "intents": ["price"], "facts": ["fair_price"] } },
    { "q": "What is the rent for a 2 bed flat in JVC?", "expect": { "areas": ["Jumeirah Village Circle"], "subType": "Flat", "rooms": "2 B/R", "intents": ["rent"], "answer": ["Ejari", "Jumeirah Village Circle"] } },
    { "q": "studio rent in international city", "expect": { "areas": ["International City Ph 1"], "rooms": "Studio", "intents": ["rent"], "answer": ["under 40 sqm"] } },
    { "q": "1 bed rent downtown", "expect": { "areas": ["Burj Khalifa"], "rooms": "1 B/R", "intents": ["rent"], "answer": ["Burj Khalifa"] } },
    { "q": "My rent in Dubai Marina is 90,000 for 900 sqft. Can the landlord increase it?", "expect": { "areas": ["Dubai Marina"], "sizeSqft": 900, "rent": 90000, "intents": ["rent"], "facts": ["rent_check"], "answer": ["RERA"] } },
