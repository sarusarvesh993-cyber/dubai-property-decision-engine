    { "q": "what is the rental yield in Dubai Sports City", "expect": { "areas": ["Dubai Sports City"], "intents": ["yield"], "answer": ["yield"] } },
    { "q": "Which communities are heating up?", "expect": { "areas": [], "intents": ["trend"], "answer_any": ["Heating", "heating"] } },
    { "q": "is the market cooling in palm jumeirah", "expect": { "areas": ["Palm Jumeirah"], "intents": ["trend"], "answer": ["Palm Jumeirah"] } },
    { "q": "cheapest areas to buy an apartment", "expect": { "areas": [], "subType": "Flat", "intents": ["price", "rank"], "answer": ["Lowest median"] } },
    { "q": "most expensive communities per sqft", "expect": { "areas": [], "intents": ["price", "rank"], "answer_any": ["Highest median", "median"] } },
    { "q": "Compare Dubai Hills vs Arabian Ranches villas", "expect": { "areas": ["Dubai Hills", "Arabian Ranches I"], "subType": "Villa", "intents": ["compare"], "answer": ["Dubai Hills", "Arabian Ranches I"] } },
    { "q": "downtown", "expect": { "areas": ["Burj Khalifa"], "intents": ["profile"], "answer": ["Burj Khalifa"] } },
    { "q": "tell me about business bay", "expect": { "areas": ["Business Bay"], "intents": ["profile"], "answer": ["Business Bay"] } },
    { "q": "any anomalies in dubai marina", "expect": { "areas": ["Dubai Marina"], "intents": ["anomaly"], "answer_any": ["Dubai Marina", "anomal"] } },
    { "q": "how is the market this week", "expect": { "areas": [], "intents": ["overview"], "answer": ["registered sales"] } },
    { "q": "off plan prices in dubai creek harbour", "expect": { "areas": ["Dubai Creek Harbour"], "offplan": true, "intents": ["price"], "answer": ["Dubai Creek Harbour"] } },
