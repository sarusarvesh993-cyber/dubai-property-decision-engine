# Optional: free-tier LLM keys for the weekly market note and the site's Ask box (any one is enough; all are optional).
# Get them at: console.groq.com/keys, aistudio.google.com/apikey, cloud.cerebras.ai, openrouter.ai/keys
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Pin a favourite model (provider:model); leave empty to let the router choose.
LLM_MODEL=

# Gateway page size (max 5000)
DLD_PAGE_SIZE=5000

# The same keys power the site's Ask box (web/app/api/ask). For the deployed site add them in
# Vercel: Project, Settings, Environment Variables (all environments), then redeploy.
# For local `npm run dev` copy the keys into web/.env.local (git-ignored).
